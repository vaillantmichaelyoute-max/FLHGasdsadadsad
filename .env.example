VITE_LAUNCHER_NAME=Project Fishk
VITE_LAUNCHER_VERSION=1.0.58
VITE_UPDATER_CONFIGURED=true
VITE_ENABLE_API=true
VITE_BACKEND_URL=http://127.0.0.1:8080
VITE_AUTH_API_URL=http://127.0.0.1:3552
VITE_DISCORD_LINK=https://example.com
VITE_DISCORD_CLIENT_ID=
# Keep the OAuth secret in the local auth-server environment only. Never prefix it with VITE_.
DISCORD_CLIENT_SECRET=
# Register this exact callback URL in the Discord Developer Portal.
DISCORD_REDIRECT_URI=http://127.0.0.1:3552/api/auth/discord/callback
VITE_LOGO_URL=/Images/logo.png
VITE_BACKGROUND_URL=/Images/build-placeholder.webp
VITE_PLACEHOLDER_IMAGE=/Images/build-placeholder.webp
VITE_UPDATER_CONFIGURED=false
